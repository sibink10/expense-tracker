<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>QubiqonFinanceHub.Mcp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Official C# MCP SDK + ASP.NET Core (Streamable HTTP) transport.
         If restore fails, refresh to the latest published prerelease via
         "dotnet add package ModelContextProtocol.AspNetCore". -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="0.3.0-preview.3" />

    <!-- Validate the inbound Entra ID access token from the chatbot -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
    <PackageReference Include="Microsoft.Identity.Web" Version="3.5.0" />
  </ItemGroup>

</Project>
