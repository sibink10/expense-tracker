<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish to STAGE App Service with this profile only.
  Runtime: ASPNETCORE_ENVIRONMENT=Staging → appsettings.json + appsettings.Staging.json
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <EnvironmentName>Staging</EnvironmentName>
    <TargetFramework>net9.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <PublishProfileName>Staging</PublishProfileName>
  </PropertyGroup>
  <ItemGroup>
    <EnvironmentVariable Include="ASPNETCORE_ENVIRONMENT" Value="Staging" />
  </ItemGroup>
</Project>
