<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish to PRODUCTION App Service with this profile only.
  Runtime: ASPNETCORE_ENVIRONMENT=Production → appsettings.json only (Development file excluded from package)
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <EnvironmentName>Production</EnvironmentName>
    <TargetFramework>net9.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <PublishProfileName>Production</PublishProfileName>
  </PropertyGroup>
  <ItemGroup>
    <EnvironmentVariable Include="ASPNETCORE_ENVIRONMENT" Value="Production" />
  </ItemGroup>
</Project>
