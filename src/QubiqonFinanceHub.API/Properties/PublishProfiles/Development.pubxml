<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish to DEV App Service with this profile only.
  Runtime: ASPNETCORE_ENVIRONMENT=Development → appsettings.json + appsettings.Development.json
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <EnvironmentName>Development</EnvironmentName>
    <TargetFramework>net9.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <PublishProfileName>Development</PublishProfileName>
  </PropertyGroup>
  <ItemGroup>
    <EnvironmentVariable Include="ASPNETCORE_ENVIRONMENT" Value="Development" />
  </ItemGroup>
</Project>
