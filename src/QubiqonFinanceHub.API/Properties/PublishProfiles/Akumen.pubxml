<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish to AKUMEN PRODUCTION App Service with this profile only.
  Runtime: ASPNETCORE_ENVIRONMENT=Production → appsettings.akumen.json swapped to appsettings.json at publish.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <EnvironmentName>Production</EnvironmentName>
    <EnableAppSettingsSwap>true</EnableAppSettingsSwap>
    <AppSettingsSourceFile>appsettings.akumen.json</AppSettingsSourceFile>
    <TargetFramework>net9.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <PublishProfileName>Akumen</PublishProfileName>
  </PropertyGroup>
  <ItemGroup>
    <EnvironmentVariable Include="ASPNETCORE_ENVIRONMENT" Value="Production" />
  </ItemGroup>
</Project>
